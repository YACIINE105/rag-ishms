APP_NAME=RAG-ISHMS
APP_VERSION=2.0.0
FILE_ALLOWED_TYPES=["text/plain", "application/pdf", "application/octet-stream"]
FILE_MAX_SIZE=1000
FILE_CHHUNK_SIZE=512000
POSTGRES_USERNAME=postgres
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=rag-ishms
GENERATION_PROVIDER=OPENAI
EMBEDDING_PROVIDER=OPENAI
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Add your own key(s); these are never included in the image or release.
OPENROUTER_API_KEYS=[]
OPENROUTER_API_KEY_INDEX=0
EMBEDDING_MODEL_ID=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_MODEL_SIZE=2048
INPUT_MAX_CHARACTERS=1024
VECTOR_DB_BACKEND=PGVector
VECTOR_DB_PATH=qdrant_db
VECTOR_DB_DISTANCE_METRIC=cosine
VECTOR_DB_PGVEC_INDEX_THRESHOLD=1000
DEFAULT_LANG=en
PRIMARY_LANG=en
LOG_LEVEL=INFO
HTTP_ACCESS_LOG_SAMPLE_RATE=0.1
GUARDRAILS_ENABLED=true
RERANKER_ENABLED=true
RERANKER_BATCH_SIZE=16
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_LENGTH=512
RERANK_WARNING_THRESHOLD=0.0
RERANK_POOL=30
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=60
INDEX_BATCH_DELAY_SECONDS=3.5
INDEX_BATCH_SIZE=64
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
APP_ENVIRONMENT=production
