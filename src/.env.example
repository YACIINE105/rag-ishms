APP_NAME="RAG-ISHMS"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_CHHUNK_SIZE=512000

 ################ DB CONFIG ################
# MONGO_URL=""
# MONGO_DATABASE="rag-ishms"

POSTGRES_USERNAME=""
POSTGRES_PASSWORD=""
POSTGRES_HOST=""
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="rag-ishms"

################ LLM CONFIG ################
COHERE_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://router.bynara.id/v1"
GOOGLE_AI_API_KEY= ""
GOOGLE_AI_BASE_URL= ""
NARA_API_KEY=""
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# JSON list; selected index starts first, then quota failures try remaining keys once.
# Empty list keeps OPENAI_API_KEY. Keys apply only to the matching OpenRouter URL.
OPENROUTER_API_KEYS=[]
OPENROUTER_API_KEY_INDEX=0



GENERATION_PROVIDER="OPENAI"
EMBEDDING_PROVIDER="LLAMA_CPP"

GENERATION_MODEL_ID="nemotron-3-ultra"
EMBEDDING_MODEL_ID="gemini-embedding-001"

EMBEDDING_MODEL_PATH=/home/yacine105/rag-ishms/models/embeddings/nomic-embed-text-v1.5.Q4_K_M.gguf

EMBEDDING_MODEL_SIZE=768

INPUT_MAX_CHARACTERS=1024
GENERATION_MODEL_TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=200
LLAMA_CPP_N_CTX = 2048
LLAMA_CPP_N_GPU_LAYERS = -1


################ VICTOR DB CONFIG ################

VECTOR_DB_BACKEND= "QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METRIC="cosine"

################ Template Configs ################
Default_Lang = "en"
DEFAULT_LANG = "en"
PRIMARY_LANG = "en"

# Optional separate OpenAI-compatible generation server (vLLM stays external)
GENERATION_BASE_URL=
GENERATION_API_KEY=
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=16
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_LENGTH=512

# Private demo defaults. Enable before sharing through nginx/tunnel.
API_AUTH_ENABLED=false
# JSON maps secret keys (24+ characters) to configured user/project identities.
API_CLIENTS={}
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=60
# Set to 3.5 for pacing batches against a free upstream API.
INDEX_BATCH_DELAY_SECONDS=0
GUARDRAILS_ENABLED=true
RERANK_POOL=30
RERANKER_ENABLED=true
# Optional; set only after calibrating the score for your reranker.
# RERANK_MIN_SCORE=0.0
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
APP_ENVIRONMENT=development
